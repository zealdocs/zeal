    <packageSourceUrl>https://github.com/zealdocs/zeal/tree/main/pkg/chocolatey</packageSourceUrl>
    <bugTrackerUrl>https://github.com/zealdocs/zeal/issues</bugTrackerUrl>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
